{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependabot keeps the Cargo dependencies, the action SHAs and the pre-commit hooks
  // (.github/dependabot.yaml). Renovate owns what Dependabot cannot update: the mise.toml tools,
  // the mise version mise-action installs, and the annotated PREK_VERSION in the workflow. It
  // never touches an action SHA. It runs from yo61/infrastructure's workflow, whose cron is the
  // only schedule; do not add a `schedule`.
  extends: ["config:recommended", "customManagers:githubActionsVersions"],
  enabledManagers: ["github-actions", "mise", "custom.regex"],

  // Policy shared by every repository Renovate updates; keep the copies alike.
  semanticCommits: "enabled",
  dependencyDashboard: true,
  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    semanticCommitType: "fix",
    labels: ["security"],
  },

  packageRules: [
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      // Action SHAs are Dependabot's; Renovate's are, below, jdx/mise.
      matchManagers: ["github-actions"],
      matchDatasources: ["!github-runners"],
      enabled: false,
    },
    {
      // mise-action's `version` input, in every job, moves in one PR.
      matchManagers: ["github-actions"],
      matchDepTypes: ["uses-with"],
      matchDepNames: ["jdx/mise"],
      enabled: true,
      groupName: "mise",
    },
    {
      matchFileNames: [".github/workflows/**"],
      semanticCommitScope: "ci",
    },
  ],
}
